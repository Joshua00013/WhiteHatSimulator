; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WhiteHatSimulator"
run/main_scene="uid://bw63rufk8of5w"
config/use_custom_user_dir=true
config/custom_user_dir_name="SaveSystem"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Singletons/game_manager.gd"
DayAndNightManager="*res://Scripts/Globals/day_and_night_manager.gd"
CyberattackAdaptationManager="*res://Scripts/Globals/cyberattack_adaptation_manager.gd"
CyberattackManager="*res://Scripts/Globals/cyberattack_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
UiManager="*res://Scripts/Globals/ui_manager.gd"
ConfigFileHandler="*res://Scripts/Globals/config_file_handler.gd"
HandTrackerServer="*res://Scripts/Globals/hand_tracker_server.gd"
SceneTransition="*res://Scenes/GUI/scene_transition.tscn"
SignalBus="*res://Scripts/Globals/signal_bus.gd"
MusicPlayer="*res://Sounds/audio_stream_player.tscn"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"Alwyn": "res://Dialogues/Timelines/Alwyn.dtl",
"Brian": "res://Dialogues/Timelines/Brian.dtl",
"Gigi": "res://Dialogues/Timelines/Gigi.dtl",
"Joe": "res://Dialogues/Timelines/Joe.dtl",
"John": "res://Dialogues/Timelines/John.dtl",
"Koro": "res://Dialogues/Timelines/Koro.dtl",
"Liz": "res://Dialogues/Timelines/Liz.dtl",
"Mike": "res://Dialogues/Timelines/Mike.dtl",
"Mococo": "res://Dialogues/Timelines/Mococo.dtl",
"Myrione": "res://Dialogues/Timelines/Myrione.dtl",
"Robert": "res://Dialogues/Timelines/Robert.dtl",
"Sai": "res://Dialogues/Timelines/Sai.dtl",
"Shion": "res://Dialogues/Timelines/Shion.dtl",
"Walter": "res://Dialogues/Timelines/Walter.dtl",
"Wisadel": "res://Dialogues/Timelines/Wisadel.dtl",
"caught": "res://Dialogues/Timelines/caught.dtl"
}
variables={
"has_coffee": false,
"has_id": false,
"has_pass": false
}
layout/style_list=["res://Dialogues/Styles/Default.tres"]
layout/default_style="res://Dialogues/Styles/Default.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
glossary/default_case_sensitive=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="WhiteHatSimulator"

[editor_plugins]

enabled=PackedStringArray("res://addons/RadialMenu/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/ridiculous_coding/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[file_customization]

folder_colors={
"res://Scenes/": "red",
"res://Scenes/GUI/": "green"
}

[global_group]

interact_ray=""

