  display: block;
  margin: 5px 0 15px;
  font-size: 12px;
  color: #333;
  text-decoration: none;
}

.forgot:hover {
  text-decoration: underline;
}

.login-box button {
  width: 90%;
  padding: 10px;
  background-color: #7d36d6; /* purple login button */
  border: none;
  color: white;
  font-weight: bold;
  cursor: pointer;
  border-radius: 3px;
}


.login-box button:hover {
  background-color: #5e28a4;
}

.help-banner {
  background-color: #8a2be2; 
  margin-top: 10px;
  padding: 10px;
  border-radius: 3px;
}

.help-banner a {
  color: white;
  font-weight: bold;
  font-size: 13px;
  text-decoration: none;
}", "body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  background-color: #c4c4c4; /* matches gray background */
}

.login-container {
  width: 400px;
  margin: 80px auto;
  text-align: center;
}

.error-banner {
  background-color: #d9534f; /* red banner */
  color: white;
  padding: 10px;
  font-weight: bold;
  margin-bottom: 10px;
  border-radius: 3px;
}

.login-box {
  background-color: white;
  padding: 30px 20px;
  box-shadow: 0 0 3px rgba(0,0,0,0.3);
}

.login-box label {
  display: block;
  font-weight: bold;
  margin: 10px 0 5px;
  text-transform: uppercase;
}

.login-box input {
  width: 90%;
  padding: 8px;
  margin-bottom: 10px;
  border: 1px solid #999;
  border-radius: 3px;
}

.forgot {
  display: block;
  margin: 5px 0 15px;
  font-size: 12px;
  color: #333;
  text-decoration: none;
}

.forgot:hover {
  text-decoration: underline;
}

.login-box button {
  width: 90%;
  padding: 10px;
  background-color: #7d36d6; /* purple login button */
  border: none;
  color: white;
  font-weight: bold;
  cursor: pointer;
  border-radius: 3px;
}


.login-box button:hover {
  background-color: #5e28a4;
}

.help-banner {
  background-color: #8a2be2; 
  margin-top: 10px;
  padding: 10px;
  border-radius: 3px;
}

.help-banner a {
  color: white;
  font-weight: bold;
  font-size: 13px;
  text-decoration: none;
}

.help-banner a:hover {
  text-decoration: underline;
}"]
}
