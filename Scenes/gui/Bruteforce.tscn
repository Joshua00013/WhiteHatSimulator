text = "import random

character = \"0123456789abcdefghijklmnopqrstuvwzyzñABCDEFGHIJKLMNOPQ
RSTUVWXYZÑ \"
character_list = list(character)

password = \"Cypher2025\"
guess = \"\"

while (guess != password):
	guess = random.choices(character_list, k=len(password))
	print(guess)
	guess = \"\".join(guess)
	print(guess)
print(\"The password is \"+ guess)
"
