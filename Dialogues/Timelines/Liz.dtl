if {lied_to_liz}  ==  false and CyberattackAdaptationManager.lied_to_liz == false and DayAndNightManager.initial_day == 4:
	# only trigger at day 4
	Hey, new guy! Can you do me a favor?
	Can you login to my PC for me and send an email to Al?
	- Yeah, sure.
		Nice! You're the best!
		Okay okay, the username is Liz and the password is "{liz_password}"
		Siimple, right? I'll be in the cafeteria if you need me.
		set {lied_to_liz} = true
		set {CyberattackAdaptationManager.lied_to_liz} = true
		[signal arg="lied_to_liz"]
	- Sorry, I'm busy right now.
		Okay then.
		Guess I'll eat dust here or whatever.
elif CyberattackAdaptationManager.lied_to_liz == true:
	Go away
elif {lied_to_liz} == true and CyberattackAdaptationManager.lied_to_liz == false:
	Have you sent the email yet?
	- Not yet, can you tell me the password again?
		The password is "{liz_password}"
else:
	Hello there. You seem to be a new face out here.
